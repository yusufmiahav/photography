# Copy this file to .env and fill it in. NEVER commit .env anywhere public.

# Studio login password — pick something long and unique
ADMIN_PASSWORD=change-me-to-something-long

# Stripe (dashboard.stripe.com → Developers → API keys)
# Use sk_test_… first to test the whole flow, then switch to sk_live_…
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Stripe webhook signing secret (Developers → Webhooks → your endpoint → Signing secret)
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# The public address of the site (no trailing slash) — used for Stripe redirect URLs
PUBLIC_URL=https://yusufshoots.com

# Only needed if using the Cloudflare Tunnel option in docker-compose.yml
# CLOUDFLARE_TUNNEL_TOKEN=eyJhIjoi...
